From a96e03e02be2864ab360735a4877ea944d3ab0c1 Mon Sep 17 00:00:00 2001
From: Indr1d-C0ld <102763446+Indr1d-C0ld@users.noreply.github.com>
Date: Mon, 16 Nov 2026 00:26:01 +0100
Subject: [PATCH 02/14] SAGA2: check only FTA2.EXE when detecting the DOS
 version

The data files of the DOS version are patched by the Melchior project
(translation and fixes), so their checksums are no longer fixed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 engines/saga2/detection.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/engines/saga2/detection.cpp b/engines/saga2/detection.cpp
index 6db66e7e..82df40d8 100644
--- a/engines/saga2/detection.cpp
+++ b/engines/saga2/detection.cpp
@@ -117,16 +117,16 @@ static const SAGA2GameDescription gameDescriptions[] = {
 		},
 		GID_FTA2
 	},
-	// Faery Tale Adventure II: Halls of the Dead - English DOS version (Melchior)
+	// Faery Tale Adventure II: Halls of the Dead - English DOS version (Melchior). Only FTA2.EXE is checked, so that the data files can be patched
 	{
 		{
 			"fta2",
 			"DOS",
 			{
-				{"ftadata.hrs",	 GAME_RESOURCEFILE,					"6dc3cbed8df2ddd9f060a7dba4d33ef8", 15042},
-				{"fta.hrs",	     GAME_OBJRESOURCEFILE,				"c34a5ee5f1a14a87712a35c4a209a033", 213376},
+				{"ftadata.hrs",	 GAME_RESOURCEFILE,					nullptr, AD_NO_SIZE},
+				{"fta.hrs",	     GAME_OBJRESOURCEFILE,				nullptr, AD_NO_SIZE},
 				{"scripts.hrs",	 GAME_SCRIPTFILE,					nullptr, AD_NO_SIZE},
-				{"ftasound.hrs", GAME_SOUNDFILE,					"ce930cb38922e6a03461f55d51b4e165", 12403350},
+				{"ftasound.hrs", GAME_SOUNDFILE,					nullptr, AD_NO_SIZE},
 				{"ftaimage.hrs", GAME_IMAGEFILE,					nullptr, AD_NO_SIZE},
 				{"ftavoice.hrs", GAME_VOICEFILE,					nullptr, AD_NO_SIZE },
 				{"fta2.exe",     GAME_EXECUTABLE,					"fbae90b10c7086740d3c167a34ae8d5c", 2223710},
-- 
2.47.3

