+          putint_v       stack[-2]
+          getint         stack[-2]
+          zero
+          ne
+          jmp_false_v    @doFine
+          getint         stack[12]          ; n
+          call_member_v  1 81 deref[stack[-2] -> GameObject:0]   ; scriptGameObjectSetExtra
+          getint         stack[12]          ; quantità
+          getint         thread[4]
+          call_member    0 0 this[0]
+          call_member_v  3 19 deref[stack[-2] -> GameObject:0]   ; scriptGameObjectDropMergeableOn
+@doFine:
+          one
+          return
