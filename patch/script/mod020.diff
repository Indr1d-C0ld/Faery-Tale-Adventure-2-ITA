+; Brythe (attore 32854, classe nuova: export 1828) -------------------------------
+          .func onReceive
+@brytheReceive:
+          enter          4                 ; stack[-2] prototipo ricevuto, stack[-4] battuta
+          call_member    0 9 deref[thread[6] -> GameObject:0]   ; scriptActorGetProto
+          putint_v       stack[-2]
+          getint         stack[-2]
+          constint       168               ; Celestial Orb
+          eq
+          jmp_false_v    @bCorona
+          one
+          putint_v       data[5000]
+          strlit         "The Celestial Orb... I have seen it before, long ago, in my father's hands. How strange that I should remember it so clearly."
+          putint_v       stack[-4]
+          jmp            @bPezzo
+@bCorona:
+          getint         stack[-2]
+          constint       970               ; Crown of Pentere
+          eq
+          jmp_false_v    @bScettro
+          one
+          putint_v       data[5002]
+          strlit         "The Crown of Pentere! The ogres who slew my mother took it as a trophy... You have brought it back from the dark."
+          putint_v       stack[-4]
+          jmp            @bPezzo
+@bScettro:
+          getint         stack[-2]
+          constint       971               ; Scepter of Pentere
+          eq
+          jmp_false_v    @bAltro
+          one
+          putint_v       data[5004]
+          strlit         "The Scepter of Pentere. My father let me hold it once, when I was very small. It is warm, as if it knew me."
+          putint_v       stack[-4]
+@bPezzo:
+          getint         thread[6]
+          ccall_v        1 scriptDeleteObject
+          getint         data[5000]
+          getint         data[5002]
+          land
+          getint         data[5004]
+          land
+          jmp_true_v     @bCompleta
+          strlit         " The Regalia of King Kiger is made of three pieces. Bring me the others, and Pentere shall know the truth."
+          zero
+          getint         stack[-4]
+          zero
+          zero
+          call_member_v  5 48 this[0]       ; scriptActorSay
+          one
+          return
+@bCompleta:
+          one
+          putint_v       data[5006]
+          strlit         " The Crown, the Orb and the Scepter, together again... They answer to my blood. I am Brythe, daughter of Karassmus, and I will take my father's throne when Farr is whole again. Take these, and let the people know that their troubled times are passed."
+          zero
+          getint         stack[-4]
+          zero
+          zero
+          call_member_v  5 48 this[0]       ; scriptActorSay
+          strlit         "The Regalia has proven Brythe heir to the throne of Pentere."
+          ccall_v        1 scriptStatus
+          constint       496               ; Declaration of New Sovereign (libro 496)
+          getint         stack[10]
+          getint         stack[8]
+          call_near      3 @dono_libro
+          putint_v       stack[-2]
+          constint       497               ; Royal Decree (libro 497)
+          getint         stack[10]
+          getint         stack[8]
+          call_near      3 @dono_libro
+          putint_v       stack[-2]
+          constint       500               ; 500 monete d'oro
+          getint         stack[10]
+          getint         stack[8]
+          call_near      3 @dono_oro
+          putint_v       stack[-2]
+          one
+          return
+@bAltro:
+          getint         stack[10]          ; this (indice), argomento nascosto dei metodi
+          getint         stack[8]           ; this (segmento)
+          call_far       2 20:390           ; onReceive generico delle persone
+          return
+
+; Wort (attore 32772, classe nuova: export 1829) ----------------------------------
+          .func onTalkTo
+@wortTalk:
+          enter          2
+          getint         data[5010]
+          jmp_false_v    @wGenerico
+          getint         data[5012]
+          jmp_true_v     @wGenerico
+          one
+          putint_v       data[5012]
+          strlit         "You did it! Not a single rat left in my granary, and the holes have gone quiet. The council promised a reward to whoever got rid of the vermin. Here, you've earned every coin."
+          zero
+          zero
+          call_member_v  3 48 this[0]       ; scriptActorSay
+          constint       150
+          getint         stack[10]
+          getint         stack[8]
+          call_near      3 @dono_oro
+          putint_v       stack[-2]
+          return_v
+@wGenerico:
+          getint         stack[10]          ; this (indice)
+          getint         stack[8]           ; this (segmento)
+          call_far       2 244:424          ; onTalkTo generico
+          return_v
