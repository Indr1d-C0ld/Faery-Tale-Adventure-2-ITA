+; Funzioni di servizio -------------------------------------------------------------
+; dono_libro(this, n): crea una pergamena col testo n e la dà a chi ha interagito (thread[4]).
+; I metodi ricevono this come primi due argomenti (stack[8] segmento, stack[10] indice): chi
+; chiama con call_near deve spingerli, altrimenti this[...] legge dati sbagliati.
+          .func dono_libro
+@dono_libro:
+          enter          2
+          zero
+          zero
+          constint       650               ; Scroll
+          ccall          3 scriptMakeObject
+          putint_v       stack[-2]
+          getint         stack[-2]
+          zero
+          ne
+          jmp_false_v    @dlFine
+          getint         stack[12]          ; n
+          call_member_v  1 81 deref[stack[-2] -> GameObject:0]   ; scriptGameObjectSetExtra
+          getint         thread[4]
+          call_member    0 0 this[0]
+          call_member_v  2 18 deref[stack[-2] -> GameObject:0]   ; scriptGameObjectDropOn
+@dlFine:
+          one
+          return
+
